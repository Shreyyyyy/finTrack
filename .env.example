# finTrack Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials.
# Get these free from: https://supabase.com/dashboard/project/_/settings/api

# Public Supabase URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anonymous Key (safe for client-side usage with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Server-only Service Role Key (used strictly by secure backend webhook/admin endpoints if needed)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Base URL (e.g. for Apple Shortcut Webhook endpoint)
NEXT_PUBLIC_APP_URL=http://localhost:3000
